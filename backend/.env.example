# Application Configuration
APP_NAME="AI Proctoring Platform"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-key-min-32-chars-long-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/proctoring_db
# SQLite local fallback (default for easy setup):
DATABASE_URL=sqlite+aiosqlite:///./proctoring.db

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=storage
SNAPSHOTS_DIR=storage/snapshots
REPORTS_DIR=storage/reports

# Computer Vision & Proctoring Engine Settings
# Temporal smoothing and thresholds
HEAD_POSE_YAW_THRESHOLD=25.0       # Max degrees turned left/right before flagging
HEAD_POSE_PITCH_THRESHOLD=20.0     # Max degrees tilted up/down before flagging
LOOK_AWAY_ALERT_SECONDS=3.0        # Sustained looking away duration to trigger event
ABSENCE_ALERT_SECONDS=3.0          # Sustained face absence duration to trigger event
MULTI_PERSON_CONFIDENCE=0.60       # Confidence threshold for multiple faces
PHONE_DETECTION_CONFIDENCE=0.55    # Confidence threshold for mobile phone / device detection
FRAME_PROCESSING_FPS=5             # Inference sampling rate (frames per second)
